{
  "manifest_version": 3,
  "name": "PropertyGuru Shortlist Scraper",
  "version": "1.0.0",
  "description": "Export your PropertyGuru shortlist to JSON",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.propertyguru.com.sg/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.propertyguru.com.sg/myactivities/shortlist*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
